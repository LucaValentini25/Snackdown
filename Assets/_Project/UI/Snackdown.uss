:root {
    /*
     * The pixel font, set once and inherited by everything each document draws.
     *
     * -unity-font with the legacy Font rather than -unity-font-definition with a font asset. A
     * raster font asset bakes one atlas at one size and cannot be scaled, so at any size that is
     * not an exact multiple of the face it collides its own glyphs; the dynamic renderer rasterises
     * per size and hints, which is what keeps the edges hard. The importer is set to HintedRaster
     * for the same reason - Smooth antialiases away the thing that makes it pixel art.
     *
     * Every font-size below is a multiple of 8. The face is a 16-pixel em, the panel draws at 2x,
     * so 8 reference units is exactly one em on screen and every step up is a whole one. Sizes
     * between them are what blur a pixel font.
     */
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI/BoldPixels/BoldPixels.otf?fileID=12800000&guid=3f99f5136898c6846845a2eb4018c6db&type=3#BoldPixels");

    --bg: rgb(24, 22, 32);
    --panel: rgb(173, 183, 196);
    --panel-edge: rgb(120, 132, 148);
    --ink: rgb(34, 31, 45);
    --ink-dim: rgb(88, 83, 110);
    --accent: rgb(186, 58, 44);
    --accent-ink: rgb(255, 253, 245);
    --ok: rgb(46, 122, 52);
    --bad: rgb(176, 44, 44);
    --hud-ink: rgb(238, 236, 246);
    --hud-ink-dim: rgb(158, 154, 176);
    --hud-accent: rgb(240, 122, 106);
    --hud-ok: rgb(126, 200, 130);
    --hud-bad: rgb(232, 112, 112);
    --gap: 12px;
    --radius: 6px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--bg);
    background-image: url("project://database/Assets/Pixel%20Adventure%201/Assets/Background/Brown.png?fileID=21300000&guid=ca6a66f8e2ae9c24c8c6b39c49206a0d&type=3#Brown");
    background-repeat: repeat repeat;
    background-size: 128px 128px;
}

.panel > * {
    flex-shrink: 0;
}

.settings__row {
    flex-shrink: 0;
}

.panel {
    width: 420px;
    padding: 16px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Frame01a.png?fileID=21300000&guid=31b3125525179334e8427d31167f3a5e&type=3#UI_Flat_Frame01a");
    -unity-slice-left: 5;
    -unity-slice-top: 7;
    -unity-slice-right: 5;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 3px;
}

.panel--wide {
    width: 760px;
}

.panel--narrow {
    width: 400px;
    height: 300px;
    justify-content: space-evenly;
}

.field--tall > .unity-base-text-field__input {
    height: 40px;
    font-size: 16px;
    padding: 0 10px;
}

.field--tall > .unity-base-field__label {
    font-size: 16px;
    -unity-text-align: middle-left;
}

.lobby-columns {
    flex-direction: row;
}

.lobby-column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 5px;
}

.lobby-column--players {
    flex-grow: 1.35;
}

.panel--narrow > .button {
    width: 220px;
    align-self: center;
}

.button-row {
    flex-direction: row;
}

.button-row > .button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 5px 3px 0 3px;
}

.title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.title--hero {
    font-size: 112px;
    color: var(--ink);
    margin-bottom: 0;
}

.subtitle--hero {
    font-size: 32px;
    color: var(--ink-dim);
    margin-bottom: 22px;
}

.field {
    margin-bottom: var(--gap);
}

.field > .unity-base-field__label {
    min-width: 84px;
    color: var(--ink);
    font-size: 24px;
}

.field > .unity-base-text-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 8px 10px;
    font-size: 24px;
}

/* The default theme sets -unity-font-definition on the text elements themselves, and a definition
   outranks -unity-font whatever the cascade says. Setting the font on the root alone left every
   label still drawing in NotInter: an inherited value loses to a rule that matches the element
   directly. So it is set again here, on the class every label and every button's text carries. */
.unity-text-element {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI/BoldPixels/BoldPixels.otf?fileID=12800000&guid=3f99f5136898c6846845a2eb4018c6db&type=3#BoldPixels");
}

/* Unity's own theme paints a grey over a hovered button, and it reaches it through one pseudo-class
   more than this rule used to carry: .unity-button:hover:enabled outranks .unity-button:hover, so
   three passes at overriding the colour still resolved to a flat 0.82 grey. Reading the resolved
   style of a button with its hover state forced is what finally said so. Matching that specificity
   is the entire fix - USS has no !important to fall back on, and the nine-slice sprite already
   carries every state these buttons have, so the colour underneath is never the one wanted. */
.unity-button:hover:enabled,
.unity-button:active:enabled,
.unity-button:hover:active:enabled,
.unity-button:focus:enabled,
.unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.button {
    height: 60px;
    margin: 5px 0 0 0;
    padding: 0 16px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_1.png?fileID=21300000&guid=79a4c9355a147504f97b2c0be2399cd5&type=3#UI_Flat_Button01a_1");
    -unity-slice-left: 3;
    -unity-slice-top: 7;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    font-size: 24px;
    -unity-font-style: bold;
}

.button:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_2.png?fileID=21300000&guid=33335e8707689f146b9c60a04d5ba37a&type=3#UI_Flat_Button01a_2");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button:active {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_3.png?fileID=21300000&guid=7694e75eb189a6c4fabadff67eca6ed8&type=3#UI_Flat_Button01a_3");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button:disabled {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_4.png?fileID=21300000&guid=25e4fc7e87408e54eba7a369032dd273&type=3#UI_Flat_Button01a_4");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 1;
    color: var(--ink-dim);
}

.button--primary {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_1.png?fileID=21300000&guid=af1f0bd5190137a4fa231bebbd40a37e&type=3#UI_Flat_Button02a_1");
    -unity-slice-left: 5;
    -unity-slice-top: 10;
    -unity-slice-right: 5;
    -unity-slice-bottom: 6;
}

.button--primary:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_2.png?fileID=21300000&guid=59980e2bb2767cd4ea94466b240c0933&type=3#UI_Flat_Button02a_2");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button--primary:active {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_3.png?fileID=21300000&guid=a4ffb9f82b6eb3b45a4c0f0618927522&type=3#UI_Flat_Button02a_3");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button--primary:disabled {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_4.png?fileID=21300000&guid=0b09542d5cc96da4ea6a268917ecc12d&type=3#UI_Flat_Button02a_4");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.status {
    min-height: 20px;
    margin-top: var(--gap);
    font-size: 16px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.status--error {
    color: var(--bad);
}

.roster {
    margin: 4px 0 var(--gap) 0;
    height: 152px;
    overflow: hidden;
}

.roster-row {
    flex-shrink: 0;
    overflow: hidden;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    margin-bottom: 4px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png?fileID=21300000&guid=e6dc5b8e84426544cb82d05b4a75aa27&type=3#UI_Flat_FrameSlot01a");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.roster-row__name {
    flex-shrink: 1;
    overflow: hidden;
    font-size: 16px;
    color: var(--ink);
}

.roster-row__you {
    color: var(--accent);
}

.roster-row__state {
    font-size: 16px;
    color: var(--ink-dim);
}

.roster-row__state--ready {
    color: var(--ok);
}

.browse {
    margin: 4px 0;
    min-height: 132px;
    max-height: 132px;
    overflow: hidden;
}

.browse__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 10px;
    margin: 0 0 4px 0;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png?fileID=21300000&guid=e6dc5b8e84426544cb82d05b4a75aa27&type=3#UI_Flat_FrameSlot01a");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.browse__row:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01b.png?fileID=21300000&guid=b85868e5c107d4740a2544281d921551&type=3#UI_Flat_FrameSlot01b");
}

.browse__row--full {
    opacity: 0.45;
}

.browse__name {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.browse__slots {
    font-size: 16px;
    color: var(--ink-dim);
}

.browse__empty {
    font-size: 16px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    padding: 24px 0;
    white-space: normal;
}

.roster-row__kick {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 2px 7px;
    font-size: 16px;
    color: var(--ink-dim);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--ink-dim);
    border-radius: 3px;
}

.roster-row__kick:hover {
    color: var(--bad);
    border-color: var(--bad);
}

.wardrobe {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--gap);
}

.wardrobe__skin {
    width: 58px;
    height: 58px;
    margin: 0 3px;
    padding: 0;
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 0;
    background-image: url("project://database/Assets/Pixel%20Adventure%201/Assets/Background/Gray.png?fileID=21300000&guid=ffc80c129c9aca14c9fb4dbeba0e10d2&type=3#Gray");
    -unity-background-scale-mode: scale-and-crop;
}

.wardrobe__portrait {
    flex-grow: 1;
    margin: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.wardrobe__skin--yours {
    border-width: 3px;
    border-color: var(--accent);
    background-image: url("project://database/Assets/Pixel%20Adventure%201/Assets/Background/Yellow.png?fileID=21300000&guid=4d8c75a4d7dd2a0489270e1058d82128&type=3#Yellow");
}

.wardrobe__skin--taken {
    opacity: 0.35;
}

.settings {
    margin-bottom: var(--gap);
    padding: 8px 10px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png?fileID=21300000&guid=e6dc5b8e84426544cb82d05b4a75aa27&type=3#UI_Flat_FrameSlot01a");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.settings__title {
    font-size: 16px;
    color: var(--ink);
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.settings__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.settings__label {
    font-size: 16px;
    color: var(--ink);
}

.settings__control {
    width: 112px;
    min-width: 112px;
    margin: 0;
}

.settings__label {
    flex-shrink: 1;
    overflow: hidden;
}

.settings__control > .unity-base-field__label {
    display: none;
}

.settings__control .unity-base-popup-field__text {
    text-overflow: ellipsis;
    overflow: hidden;
}

.settings__control > .unity-base-popup-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

.settings__control > .unity-base-text-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

.arena-preview {
    height: 62px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--panel-edge);
    background-color: var(--bg);
    -unity-background-scale-mode: scale-to-fit;
}

.arena-picker {
    margin: 0;
}

.arena-picker > .unity-base-field__label {
    display: none;
}

.arena-picker > .unity-base-popup-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

.icon-button {
    width: 30px;
    height: 30px;
    margin: 0 0 0 6px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-button:hover {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 0.7;
}

.icon-button:disabled {
    opacity: 0.35;
}

.icon-button--copy {
    background-image: url("project://database/Assets/_Project/Art/UI/Icon_Copy.png?fileID=21300000&guid=b5343f59f7f3dd747b51fbb4e7e70f32&type=3#Icon_Copy");
}

.icon-button--paste {
    background-image: url("project://database/Assets/_Project/Art/UI/Icon_Paste.png?fileID=21300000&guid=cd68e5764f92f7f4cace17b8a1dfe8d8&type=3#Icon_Paste");
}

.icon-button--refresh {
    background-image: url("project://database/Assets/_Project/Art/UI/Icon_Refresh.png?fileID=21300000&guid=9be277fc8f87878418f5f261f42607b2&type=3#Icon_Refresh");
}

.browse-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.code-row {
    flex-direction: row;
    align-items: center;
}

.code-row__field {
    flex-grow: 1;
    margin-bottom: 0;
}

.number-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 26px;
    padding: 0 4px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
}

.number-stepper__readout {
    flex-grow: 1;
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.number-stepper__arrow {
    width: 14px;
    font-size: 16px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.number-stepper__arrow:hover {
    color: var(--accent);
}

.number-stepper:focus {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField02a.png?fileID=21300000&guid=03f5b965037a4b74a924f6690a27593c&type=3#UI_Flat_InputField02a");
}

.number-stepper:focus > .number-stepper__arrow {
    color: var(--accent);
}

.settings__control:disabled {
    opacity: 0.5;
}

.join-code-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 8px;
}

.join-code {
    width: 190px;
    padding: 7px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png?fileID=21300000&guid=d946c65cdc82e524e814868755865e28&type=3#UI_Flat_InputField01a");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.button--compact {
    height: 30px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 16px;
}

.hidden {
    display: none;
}

.loading-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 11, 16);
}

.loading-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    margin-bottom: 6px;
}

.loading-detail {
    font-size: 16px;
    color: var(--hud-ink-dim);
    margin-bottom: 18px;
}

.progress-track {
    width: 380px;
    height: 14px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Bar01a.png?fileID=21300000&guid=78b64d89be52dbe4f9c75f5dc8219b65&type=3#UI_Flat_Bar01a");
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--hud-accent);
    transition-property: width;
    transition-duration: 0.25s;
}

.countdown {
    margin-top: 20px;
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--hud-accent);
}

.end-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 11, 16, 0.72);
}

.end-panel {
    min-width: 380px;
    align-items: center;
}

.end-panel .title {
    -unity-text-align: middle-center;
}

.end-panel .subtitle {
    -unity-text-align: middle-center;
}

/* A far lighter dim than the end screen's. That one covers a match that is over; this one covers a
   match that is still being played, and the player is still in it - they keep control while this is
   open, so hiding what is happening to them at 72% would take with one hand what the design gives
   with the other. Enough to say a menu is open, not enough to blind anybody. */
.escape-root {
    background-color: rgba(12, 11, 16, 0.35);
}

/* The escape menu borrows the end screen's dimmed backdrop and centred panel, because it is the
   same shape of thing: a panel over a match that is still running behind it. What it does not
   borrow is the width - this one is a column of buttons and nothing else, so a 380px minimum
   would leave it mostly empty. */
.escape-panel {
    min-width: 260px;
    align-items: center;
}

.escape-panel .title,
.escape-panel .subtitle {
    -unity-text-align: middle-center;
}

.escape-panel > .button {
    width: 220px;
    align-self: center;
}

/* The on-screen pad. It does not fill or centre anything: every child is placed against a corner,
   because the reachable part of a phone held in two hands is the two bottom corners and nothing in
   between. The root carries the safe-area inset as padding, which is why the corners are measured
   from it rather than from the screen. */
.touch-root {
    flex-grow: 1;
}

/* Inset from each edge by the safe area at runtime. Absolute rather than padding on the root,
   because a corner-positioned child measures from the border edge and would ignore padding. */
.touch-safe {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.touch-cluster {
    position: absolute;
    bottom: 20px;
    flex-direction: row;
}

.touch-cluster--left {
    left: 20px;
}

.touch-cluster--right {
    right: 20px;
}

/* Round, and drawn as a plain disc rather than with the pack's nine-slice frame. A sliced sprite
   cannot be made circular by a corner radius - the frame is part of the image - so a touch key that
   wants to be round has to stop being one of those buttons and say so. Sized for a thumb rather
   than a cursor, which is why they do not inherit the 220x60 the rest of the project uses. */
.touch-key {
    width: 72px;
    height: 72px;
    margin: 0 10px 0 0;
    padding: 0;
    font-size: 32px;
    border-width: 2px;
    border-radius: 36px;
    border-color: var(--panel-edge);
    background-image: none;
    background-color: var(--panel);
    color: var(--ink);
    opacity: 0.7;
}

.touch-key:hover,
.touch-key:active {
    background-color: var(--panel);
    border-color: var(--panel-edge);
    opacity: 0.9;
}

.touch-key--jump {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin: 0;
}

.touch-key--pause {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin: 0;
}

.clock-root {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.round-clock {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    padding: 2px 12px;
    background-color: rgba(12, 11, 16, 0.55);
    border-radius: 4px;
}

.round-clock--urgent {
    color: var(--hud-bad);
}

.nameplate {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

.nameplate__name {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(12, 11, 16);
    margin-bottom: 4px;
    flex-shrink: 1;
}

.nameplate__track {
    width: 100%;
    height: 16px;
    flex-shrink: 0;
    background-color: rgba(12, 11, 16, 0.75);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(12, 11, 16);
    overflow: hidden;
}

.nameplate__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-ok);
}

.nameplate__fill--low {
    background-color: var(--hud-bad);
}

.lifebars-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    padding: 10px;
}

.lifebars-row {
    flex-direction: row;
    justify-content: center;
}

.lifebar {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
    padding: 6px 10px;
    background-color: rgba(12, 11, 16, 0.72);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--panel-edge);
}

.lifebar__portrait {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    background-color: var(--panel);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.lifebar__column {
    min-width: 130px;
}

.lifebar__name {
    font-size: 16px;
    color: var(--hud-ink);
    margin-bottom: 3px;
}

.lifebar__name--you {
    color: var(--hud-accent);
}

.lifebar__track {
    height: 14px;
    background-image: none;
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(12, 11, 16, 0.85);
    overflow: hidden;
}

.lifebar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-ok);
}

.lifebar__fill--low {
    background-color: var(--hud-bad);
}

.lifebar__seconds {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    margin-left: 10px;
    min-width: 46px;
    -unity-text-align: middle-right;
}

.lifebar--out {
    opacity: 0.45;
}

.lifebar--watched {
    border-color: var(--hud-accent);
    background-color: rgba(238, 108, 92, 0.18);
}


