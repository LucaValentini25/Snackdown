/*
 * Shared styling for every screen: menu, lobby, loading, in-match HUD and end screen.
 *
 * Deliberately built from a handful of variables rather than per-element values: the palette and
 * spacing are the two things that change when placeholder art is replaced with real art, and having
 * them in one block is the difference between editing five lines and hunting through the file.
 *
 * ── The nine-slice numbers live here, and that is not an accident ──────────────────
 *
 * Every frame, button and field below is a pixel-art sprite stretched to a size it was not drawn
 * at, so it is cut into nine pieces: the four corners are drawn as they are, the four edges repeat
 * along one axis, and the middle fills. The cut is the -unity-slice-* block on each rule.
 *
 * The same numbers also exist on the sprites themselves, set in the Sprite Editor, and UI Toolkit
 * does NOT read them. That was measured rather than assumed: an element given
 * UI_Flat_Frame01a - whose own border is 5, 7, 5, 7 - resolves to a slice of 0 on every side.
 * The Sprite Editor values are still worth having, because they are where these came from and
 * because a SpriteRenderer would use them, but the stylesheet is what decides what is drawn.
 *
 * The sprites are imported at 100 pixels per unit, unlike the rest of the project's art, which is
 * on a 32 grid. UI Toolkit scales the slice by the sprite's pixels-per-unit, and 100 is the value
 * its own defaults are written against. A UI sprite has no size in world units to be consistent
 * about.
 */

:root {
    --bg: rgb(24, 22, 32);
    --panel: rgb(38, 35, 50);
    --panel-edge: rgb(62, 57, 82);
    --ink: rgb(232, 230, 240);
    --ink-dim: rgb(150, 146, 168);
    --accent: rgb(238, 108, 92);
    --accent-ink: rgb(28, 24, 30);
    --ok: rgb(126, 200, 130);
    --bad: rgb(232, 112, 112);

    --gap: 12px;
    --radius: 6px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--bg);
}

.panel {
    width: 420px;
    padding: 24px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Frame01a.png");
    -unity-slice-left: 5;
    -unity-slice-top: 7;
    -unity-slice-right: 5;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 3px;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    white-space: normal;
}

/* ── fields ─────────────────────────────────────────────────────────────────────── */

.field {
    margin-bottom: var(--gap);
}

.field > .unity-base-field__label {
    min-width: 78px;
    color: var(--ink-dim);
    font-size: 13px;
}

.field > .unity-base-text-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 8px 10px;
}

/* ── buttons ────────────────────────────────────────────────────────────────────── */

/* The pack draws a button four times, one per state, and they are used in that order: at rest,
   under the cursor, held down, and unavailable. Sliced identically, so the frame does not jump as
   the mouse crosses it — which is why the border was copied from the first state onto the other
   three rather than set four times by hand. */
.button {
    height: 40px;
    margin: 4px 0 0 0;
    padding: 0 16px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_1.png");
    -unity-slice-left: 3;
    -unity-slice-top: 7;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    font-size: 15px;
    -unity-font-style: bold;
}

.button:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_2.png");
}

.button:active {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_3.png");
}

/* The pack's fourth state, rather than the old trick of dimming the third. A greyed-out button that
   is really the normal one at 40% opacity also fades its own text, and the label is the part that
   still has to be readable. */
.button:disabled {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_4.png");
    opacity: 1;
    color: var(--ink-dim);
}

/* The one button on each screen that is the thing you came to do. It keeps the pack's frame and
   takes the accent on its label, because tinting the whole sprite would flatten the shading the
   frame is drawn with. */
.button--primary {
    color: var(--accent);
}

/* ── status line ────────────────────────────────────────────────────────────────── */

.status {
    min-height: 20px;
    margin-top: var(--gap);
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.status--error {
    color: var(--bad);
}

/* ── roster ─────────────────────────────────────────────────────────────────────── */

.roster {
    margin: 4px 0 var(--gap) 0;
    min-height: 140px;
}

.roster-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    margin-bottom: 4px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.roster-row__name {
    font-size: 15px;
    color: var(--ink);
}

.roster-row__you {
    color: var(--accent);
}

.roster-row__state {
    font-size: 12px;
    color: var(--ink-dim);
}

.roster-row__state--ready {
    color: var(--ok);
}

/* ── the game browser ─────────────────────────────────────────────────────── */

/* Fixed height rather than growing with the list: a panel that changes size every time somebody
   starts or ends a game moves the buttons under the player's cursor. */
.browse {
    margin: 4px 0;
    min-height: 132px;
    max-height: 132px;
    overflow: hidden;
}

.browse__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 10px;
    margin: 0 0 4px 0;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* The pack draws the same slot three times, and the second is the one that reads as "under the
   cursor". Swapping the sprite rather than recolouring a border, which this row no longer has. */
.browse__row:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01b.png");
}

.browse__row--full {
    opacity: 0.45;
}

.browse__name {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.browse__slots {
    font-size: 12px;
    color: var(--ink-dim);
}

/* Nobody hosting is the ordinary state of a game nobody is playing yet, so it reads as a sentence
   rather than as the error the same empty box would otherwise imply. */
.browse__empty {
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    padding: 24px 0;
    white-space: normal;
}

.roster-row__kick {
    margin-left: 10px;
    padding: 2px 10px;
    font-size: 12px;
    color: var(--ink-dim);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--ink-dim);
    border-radius: 3px;
}

.roster-row__kick:hover {
    color: var(--bad);
    border-color: var(--bad);
}

.wardrobe {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--gap);
}

.wardrobe__skin {
    width: 56px;
    height: 56px;
    margin: 0 4px;
    padding: 0;
    border-width: 2px;
    border-color: var(--bg);
    border-radius: 4px;
    background-color: var(--bg);
    -unity-background-scale-mode: scale-to-fit;
}

/* The one you are wearing, and the ones nobody can have. Border rather than a badge: at 56px a
   badge is bigger than the thing it labels. */
.wardrobe__skin--yours {
    border-color: var(--accent);
}

.wardrobe__skin--taken {
    opacity: 0.35;
}

.settings {
    margin-bottom: var(--gap);
    padding: 8px 10px;
    background-color: var(--bg);
    border-radius: 4px;
}

.settings__title {
    font-size: 12px;
    color: var(--ink-dim);
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.settings__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
}

.settings__label {
    font-size: 13px;
    color: var(--ink);
}

/* Fixed rather than growing: four rows whose fields all start at the same x read as a table,
   and a column that jogs left and right with the length of each label does not. */
.settings__control {
    width: 150px;
    margin: 0;
}

/* Every control here is labelled by a Label of its own in the row, so the one UI Toolkit builds
   inside the field is empty - and an empty label is not free. Unity's runtime theme gives it a
   min-width, which ate a third of the 130px this column used to be. That is what made "Arena 01"
   and "Arena 02" both render as "Arena 0": the field had room for every character except the one
   that told them apart, so the picker looked broken while working perfectly. */
.settings__control > .unity-base-field__label {
    display: none;
}

/* And if a name is ever genuinely too long for the column, it says so rather than quietly
   reading as a different entry. */
.settings__control .unity-base-popup-field__text {
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Dropdowns are painted like the number fields beside them. Left to the default theme they come
   out flat grey against white neighbours, which reads as disabled - and both of these are live
   controls that the host is meant to use. */
.settings__control > .unity-base-popup-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Select01a_1.png");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

/* Disabled has to look different from enabled, now that enabled no longer looks disabled. It is
   the state a client sees for the whole panel: the rules are visible and not theirs to move. */
.settings__control:disabled {
    opacity: 0.5;
}

.join-code-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gap);
}

.join-code {
    flex-grow: 1;
    padding: 10px;
    background-color: var(--bg);
    border-radius: 4px;
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* Sits next to the code rather than below it, so the pair reads as one control. */
.button--compact {
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 13px;
}

.hidden {
    display: none;
}

/* ── loading screen ─────────────────────────────────────────────────────────────── */

.loading-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 11, 16);
}

.loading-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 6px;
}

.loading-detail {
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 18px;
}

.progress-track {
    width: 380px;
    height: 14px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Bar01a.png");
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

/* Width is set from code as a percentage; the transition is what keeps it from snapping
   between the coarse steps a per-player count produces. */
.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--accent);
    transition-property: width;
    transition-duration: 0.25s;
}

.countdown {
    margin-top: 20px;
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--accent);
}

/* ── end screen ──────────────────────────────────────────────────────── */

/* Translucent, and it does not fill the screen: the arena behind it is still being watched. */
.end-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 11, 16, 0.72);
}

.end-panel {
    min-width: 380px;
    align-items: center;
}

.end-panel .title {
    -unity-text-align: middle-center;
}

.end-panel .subtitle {
    -unity-text-align: middle-center;
}

/* ── round clock ────────────────────────────────────────────────────── */

.clock-root {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.round-clock {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ink);
    padding: 2px 12px;
    background-color: rgba(12, 11, 16, 0.55);
    border-radius: 4px;
}

/* Red under the threshold, so running out is felt before it is read. */
.round-clock--urgent {
    color: var(--bad);
}

/* ── option A: nameplate over the character (world space) ────────────────────── */

/*
 * Sizes here are in the panel's authored pixels, and the panel is 160 of them wide standing for
 * 1.6 world units -- so 100 authored pixels to the metre, and a character is 70 wide. What makes
 * the text legible is that ratio, not these numbers on their own: author the same layout at four
 * times the resolution and every glyph gets squeezed into a quarter of the space on screen.
 */
.nameplate {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

.nameplate__name {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(12, 11, 16);
    margin-bottom: 4px;
    flex-shrink: 1;
}

/*
 * flex-shrink: 0 is the load-bearing line. The name and the bar together can ask for more height
 * than the plate has, and flexbox resolves that by shrinking whatever it is allowed to -- which
 * squeezed the bar to four pixels and its fill to zero, leaving a black sliver that looked like a
 * bar that never moved. The name may compress; the bar may not, because the bar is the readout.
 */
.nameplate__track {
    width: 100%;
    height: 16px;
    flex-shrink: 0;
    background-color: rgba(12, 11, 16, 0.75);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(12, 11, 16);
    overflow: hidden;
}

.nameplate__fill {
    height: 100%;
    width: 100%;
    background-color: var(--ok);
}

.nameplate__fill--low {
    background-color: var(--bad);
}

/* ── option B: life bars along the bottom ───────────────────────────────── */

.lifebars-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    padding: 10px;
}

.lifebars-row {
    flex-direction: row;
    justify-content: center;
}

.lifebar {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
    padding: 6px 10px;
    background-color: rgba(12, 11, 16, 0.72);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--panel-edge);
}

/* Cropped to the head: the pack's frames are full-body, and a full body shrunk to 40px is a smudge. */
.lifebar__portrait {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    background-color: var(--panel);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.lifebar__column {
    min-width: 130px;
}

.lifebar__name {
    font-size: 12px;
    color: var(--ink);
    margin-bottom: 3px;
}

.lifebar__name--you {
    color: var(--accent);
}

/* The track is the pack's empty bar, sliced so it can be any width; the fill is a flat colour
   inside it rather than the pack's own fill sprite. A sprite fill would have to be masked to a
   fraction of its own width, and a coloured box already reads correctly and can go red on its own
   when the life is low — which is the one thing this bar has to say. */
.lifebar__track {
    height: 14px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Bar01a.png");
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.lifebar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--ok);
}

.lifebar__fill--low {
    background-color: var(--bad);
}

.lifebar__seconds {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-left: 10px;
    min-width: 46px;
    -unity-text-align: middle-right;
}

/* Out, not gone: the entry stays so nobody else shifts position. */
.lifebar--out {
    opacity: 0.45;
}

/* Who the spectator camera is following. Arena01 is barely larger than the view, so the camera
   moving is not by itself an answer to "did that do anything?" — this is. */
.lifebar--watched {
    border-color: var(--accent);
    background-color: rgba(238, 108, 92, 0.18);
}

