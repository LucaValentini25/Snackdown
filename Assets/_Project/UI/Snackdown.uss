/*
 * Shared styling for every screen: menu, lobby, loading, in-match HUD and end screen.
 *
 * Deliberately built from a handful of variables rather than per-element values: the palette and
 * spacing are the two things that change when placeholder art is replaced with real art, and having
 * them in one block is the difference between editing five lines and hunting through the file.
 *
 * ── The nine-slice numbers live here, and that is not an accident ──────────────────
 *
 * Every frame, button and field below is a pixel-art sprite stretched to a size it was not drawn
 * at, so it is cut into nine pieces: the four corners are drawn as they are, the four edges repeat
 * along one axis, and the middle fills. The cut is the -unity-slice-* block on each rule.
 *
 * The same numbers also exist on the sprites themselves, set in the Sprite Editor, and UI Toolkit
 * does NOT read them. That was measured rather than assumed: an element given
 * UI_Flat_Frame01a - whose own border is 5, 7, 5, 7 - resolves to a slice of 0 on every side.
 * The Sprite Editor values are still worth having, because they are where these came from and
 * because a SpriteRenderer would use them, but the stylesheet is what decides what is drawn.
 *
 * The sprites are imported at 100 pixels per unit, unlike the rest of the project's art, which is
 * on a 32 grid. UI Toolkit scales the slice by the sprite's pixels-per-unit, and 100 is the value
 * its own defaults are written against. A UI sprite has no size in world units to be consistent
 * about.
 *
 * ── Every number here is half of what reaches the screen ──────────────────────────
 *
 * MenuPanelSettings has a reference resolution of 960x540, so at the 1080p this game is aimed at
 * the whole panel is drawn at exactly 2x. A width of 420 below is 840 real pixels.
 *
 * The factor is 2 and not something that merely looks right, because everything in here is pixel
 * art: at an integer scale one texel is two screen pixels and the edges stay hard, and at 1.5 they
 * do not. It follows that sizes are tuned here, in reference units, and never by reaching for the
 * reference resolution again - moving it rescales the UI and the sprites together.
 *
 * ── Do not open this file in the UI Builder ───────────────────────────────────────
 *
 * Saving from it rewrites the stylesheet in its own canonical form and DELETES EVERY COMMENT. It
 * has happened once: 176 lines of the reasoning above, gone in one save, recovered from git. It
 * also rewrites each url() into a form carrying a fileID and a guid, which works and is unreadable.
 * Edit this file as text. The UI Builder is still the right tool for looking at a document.
 */

/*
 * ── The palette is chosen against the pack, and against numbers ───────────────────
 *
 * These used to be a dark UI: near-white ink on a panel of rgb(38, 35, 50). The pack's Flat theme
 * is the opposite - its frame is rgb(173, 183, 196) and its buttons are rgb(255, 253, 245) - so
 * every one of those values had to be inverted. The old ink on the new button face measures a
 * contrast ratio of 1.21, which is not "low", it is invisible.
 *
 * The replacements were measured rather than picked, sampling the sprites and computing WCAG
 * contrast. Against the button face and the panel face respectively:
 *
 *     --ink        15.84   7.95     body text anywhere
 *     --ink-dim     7.17   3.60     secondary text on a button or field; large text on a panel
 *     --accent      5.53   2.77     body on a button, large only on a panel
 *     --ok          5.22   2.62
 *     --bad         6.36   3.19
 *
 * The one rule that falls out of it: the panel face is the weaker surface, so text sitting directly
 * on a panel takes --ink and not --ink-dim. 3.60 is fine for a label beside a control and not for a
 * sentence somebody has to read.
 *
 * --bg stays dark on purpose. It is the screen behind the panels, and the light frames need
 * something to sit against.
 */
:root {
    --bg: rgb(24, 22, 32);
    --panel: rgb(173, 183, 196);
    --panel-edge: rgb(120, 132, 148);
    --ink: rgb(34, 31, 45);
    --ink-dim: rgb(88, 83, 110);
    --accent: rgb(186, 58, 44);
    --accent-ink: rgb(255, 253, 245);
    --ok: rgb(46, 122, 52);
    --bad: rgb(176, 44, 44);

    /*
     * The HUD is the other half of the palette and it could not share the first.
     *
     * A menu is a light frame from the pack on a dark backdrop; the in-match HUD is the opposite -
     * dark translucent strips laid over a lit arena, because anything opaque there covers the game
     * it is reporting on. So the ink that reads on a panel is the ink that disappears on a life
     * bar, and vice versa. Two pairs rather than one, named for where they are allowed.
     *
     * Against the strips' rgba(12, 11, 16, 0.72), --hud-ink measures 15.3 and --hud-accent 6.4.
     */
    --hud-ink: rgb(238, 236, 246);
    --hud-ink-dim: rgb(158, 154, 176);
    --hud-accent: rgb(240, 122, 106);
    --hud-ok: rgb(126, 200, 130);
    --hud-bad: rgb(232, 112, 112);

    --gap: 12px;
    --radius: 6px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--bg);
}

/* Nothing inside a panel may be squeezed to make it fit.
 *
 * Flex shrinks its children by default, and a lobby whose content is taller than the screen does
 * not report that: it silently compresses every row until the rules panel is five labels drawn on
 * top of each other and the fields are stripes. Refusing to shrink turns a layout that lies into
 * one that overflows, which is a problem you can see and therefore fix.
 */
.panel > * {
    flex-shrink: 0;
}

.settings__row {
    flex-shrink: 0;
}

.panel {
    width: 420px;
    padding: 16px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Frame01a.png");
    -unity-slice-left: 5;
    -unity-slice-top: 7;
    -unity-slice-right: 5;
    -unity-slice-bottom: 7;
    -unity-slice-scale: 3px;
}

/* The lobby is the only screen dense enough to run out of height. Side by side, the roster and the
   rules cost the taller of the two instead of both, which is what buys the room to set the type at
   a size somebody can read across a room. */
.panel--wide {
    width: 560px;
}

/* One field and two buttons. At the lobby's width they float in the middle of an empty frame. */
.panel--narrow {
    width: 300px;
}


/* A field you type your name into should look like one from across the room. The default height
   reads as a label with a line under it. */
.field--tall > .unity-base-text-field__input {
    height: 40px;
    font-size: 18px;
    padding: 0 10px;
}

.field--tall > .unity-base-field__label {
    font-size: 16px;
    -unity-text-align: middle-left;
}

.lobby-columns {
    flex-direction: row;
}

.lobby-column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
}

/* Narrower than the panel and centred. Two actions on the front screen do not need the full width
   of anything; at it they read as a list rather than as a choice. */
.panel--narrow > .button {
    width: 220px;
    align-self: center;
}

/* Buttons share a row and the width between them. Stacked they cost this panel 150 units of the
   540 it has, and it is the one screen with no room to spare. */
.button-row {
    flex-direction: row;
}

.button-row > .button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 5px 3px 0 3px;
}

.title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

/* Declared after .title and .subtitle on purpose. Both are a single class, so neither outranks the
   other and the file's order is the whole tie-break — put these first and the plain rules win, and
   the name of the game is painted dark ink on a dark backdrop. */
.title--hero {
    font-size: 60px;
    color: var(--hud-ink);
    margin-bottom: 0;
}

.subtitle--hero {
    font-size: 17px;
    color: var(--hud-ink-dim);
    margin-bottom: 22px;
}

/* ── fields ─────────────────────────────────────────────────────────────────────── */

.field {
    margin-bottom: var(--gap);
}

.field > .unity-base-field__label {
    min-width: 84px;
    color: var(--ink);
    font-size: 15px;
}

.field > .unity-base-text-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 8px 10px;
}

/* ── buttons ────────────────────────────────────────────────────────────────────── */

/* The pack draws a button four times, one per state, and they are used in that order: at rest,
   under the cursor, held down, and unavailable. Sliced identically, so the frame does not jump as
   the mouse crosses it — which is why the border was copied from the first state onto the other
   three rather than set four times by hand. */
.button {
    height: 46px;
    margin: 5px 0 0 0;
    padding: 0 16px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_1.png");
    -unity-slice-left: 3;
    -unity-slice-top: 7;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    font-size: 17px;
    -unity-font-style: bold;
}

/* Every state repeats the transparent background and the missing border, and it is not redundant.
   The default theme styles .unity-button:hover, a pseudo-class selector that outranks our plain
   .button, so its own hover colour and border paint straight through ours - which is the white
   frame that appeared around a button under the cursor. Beating it needs a rule of at least equal
   rank, so the values live on each state rather than being inherited from one. */
.button:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_2.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button:active {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_3.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* The pack's fourth state, rather than the old trick of dimming the third. A greyed-out button that
   is really the normal one at 40% opacity also fades its own text, and the label is the part that
   still has to be readable. */
.button:disabled {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button01a_4.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 1;
    color: var(--ink-dim);
}

/* The one button on each screen that is the thing you came to do. It keeps the pack's frame and
   takes the accent on its label, because tinting the whole sprite would flatten the shading the
   frame is drawn with. */
/* Its own cut, because it is its own art. Button02a has a taller lip than Button01a - 10 pixels of
   top against 7 - and inheriting the first button's slice made UI Toolkit log the mismatch on every
   frame it drew. The numbers are the ones set on the sprite in the Sprite Editor, which is where
   they were measured off the art. */
.button--primary {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_1.png");
    -unity-slice-left: 5;
    -unity-slice-top: 10;
    -unity-slice-right: 5;
    -unity-slice-bottom: 6;
}

.button--primary:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_2.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button--primary:active {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_3.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.button--primary:disabled {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Button02a_4.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ── status line ────────────────────────────────────────────────────────────────── */

.status {
    min-height: 20px;
    margin-top: var(--gap);
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.status--error {
    color: var(--bad);
}

/* ── roster ─────────────────────────────────────────────────────────────────────── */

.roster {
    margin: 4px 0 var(--gap) 0;
    min-height: 120px;
}

.roster-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    margin-bottom: 4px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.roster-row__name {
    font-size: 16px;
    color: var(--ink);
}

.roster-row__you {
    color: var(--accent);
}

.roster-row__state {
    font-size: 12px;
    color: var(--ink-dim);
}

.roster-row__state--ready {
    color: var(--ok);
}

/* ── the game browser ─────────────────────────────────────────────────────── */

/* Fixed height rather than growing with the list: a panel that changes size every time somebody
   starts or ends a game moves the buttons under the player's cursor. */
.browse {
    margin: 4px 0;
    min-height: 132px;
    max-height: 132px;
    overflow: hidden;
}

.browse__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 10px;
    margin: 0 0 4px 0;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* The pack draws the same slot three times, and the second is the one that reads as "under the
   cursor". Swapping the sprite rather than recolouring a border, which this row no longer has. */
.browse__row:hover {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01b.png");
}

.browse__row--full {
    opacity: 0.45;
}

.browse__name {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.browse__slots {
    font-size: 12px;
    color: var(--ink-dim);
}

/* Nobody hosting is the ordinary state of a game nobody is playing yet, so it reads as a sentence
   rather than as the error the same empty box would otherwise imply. */
.browse__empty {
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    padding: 24px 0;
    white-space: normal;
}

.roster-row__kick {
    margin-left: 10px;
    padding: 2px 10px;
    font-size: 12px;
    color: var(--ink-dim);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--ink-dim);
    border-radius: 3px;
}

.roster-row__kick:hover {
    color: var(--bad);
    border-color: var(--bad);
}

.wardrobe {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--gap);
}

.wardrobe__skin {
    width: 56px;
    height: 56px;
    margin: 0 4px;
    padding: 0;
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: 4px;
    background-color: var(--accent-ink);
    -unity-background-scale-mode: scale-to-fit;
}

/* The one you are wearing, and the ones nobody can have. Border rather than a badge: at 56px a
   badge is bigger than the thing it labels. */
.wardrobe__skin--yours {
    border-color: var(--accent);
}

.wardrobe__skin--taken {
    opacity: 0.35;
}

/* Inset rather than dark. It used to be a dark box on a dark panel; on a light one the same idea
   is the pack's own slot frame, which reads as recessed without needing a colour that fights the
   ink sitting on it. */
.settings {
    margin-bottom: var(--gap);
    padding: 10px 12px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_FrameSlot01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 4;
    -unity-slice-right: 3;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.settings__title {
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.settings__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.settings__label {
    font-size: 15px;
    color: var(--ink);
}

/* Fixed rather than growing: four rows whose fields all start at the same x read as a table,
   and a column that jogs left and right with the length of each label does not. Narrower since the
   rules moved into a column half the panel's width - at the old 150 the longest labels pushed their
   fields out through the side of the frame. */
.settings__control {
    width: 118px;
    min-width: 118px;
    margin: 0;
}

/* The label yields, not the control. A clipped "Drain per second" is still readable; a clipped
   number field is a box with no number in it. */
.settings__label {
    flex-shrink: 1;
    overflow: hidden;
}

/* Every control here is labelled by a Label of its own in the row, so the one UI Toolkit builds
   inside the field is empty - and an empty label is not free. Unity's runtime theme gives it a
   min-width, which ate a third of the 130px this column used to be. That is what made "Arena 01"
   and "Arena 02" both render as "Arena 0": the field had room for every character except the one
   that told them apart, so the picker looked broken while working perfectly. */
.settings__control > .unity-base-field__label {
    display: none;
}

/* And if a name is ever genuinely too long for the column, it says so rather than quietly
   reading as a different entry. */
.settings__control .unity-base-popup-field__text {
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Dropdowns are painted like the number fields beside them. Left to the default theme they come
   out flat grey against white neighbours, which reads as disabled - and both of these are live
   controls that the host is meant to use. */
.settings__control > .unity-base-popup-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

/* The number fields in this panel carry .settings__control, not .field, so the rule that styles a
   text field on the menu never reached them and they fell through to the default theme - white
   boxes among framed ones. */
.settings__control > .unity-base-text-field__input {
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    padding: 6px 8px;
}

/* Disabled has to look different from enabled, now that enabled no longer looks disabled. It is
   the state a client sees for the whole panel: the rules are visible and not theirs to move. */
.settings__control:disabled {
    opacity: 0.5;
}

.join-code-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gap);
}

.join-code {
    flex-grow: 1;
    padding: 10px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_InputField01a.png");
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* Sits next to the code rather than below it, so the pair reads as one control. */
.button--compact {
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 13px;
}

.hidden {
    display: none;
}

/* ── loading screen ─────────────────────────────────────────────────────────────── */

.loading-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 11, 16);
}

.loading-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    margin-bottom: 6px;
}

.loading-detail {
    font-size: 13px;
    color: var(--hud-ink-dim);
    margin-bottom: 18px;
}

.progress-track {
    width: 380px;
    height: 14px;
    background-image: url("project://database/Assets/_Project/Art/UI/Crusenho/UI_Flat_Bar01a.png");
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

/* Width is set from code as a percentage; the transition is what keeps it from snapping
   between the coarse steps a per-player count produces. */
.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--hud-accent);
    transition-property: width;
    transition-duration: 0.25s;
}

.countdown {
    margin-top: 20px;
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--hud-accent);
}

/* ── end screen ──────────────────────────────────────────────────────── */

/* Translucent, and it does not fill the screen: the arena behind it is still being watched. */
.end-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 11, 16, 0.72);
}

.end-panel {
    min-width: 380px;
    align-items: center;
}

.end-panel .title {
    -unity-text-align: middle-center;
}

.end-panel .subtitle {
    -unity-text-align: middle-center;
}

/* ── round clock ────────────────────────────────────────────────────── */

.clock-root {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.round-clock {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    padding: 2px 12px;
    background-color: rgba(12, 11, 16, 0.55);
    border-radius: 4px;
}

/* Red under the threshold, so running out is felt before it is read. */
.round-clock--urgent {
    color: var(--hud-bad);
}

/* ── option A: nameplate over the character (world space) ────────────────────── */

/*
 * Sizes here are in the panel's authored pixels, and the panel is 160 of them wide standing for
 * 1.6 world units -- so 100 authored pixels to the metre, and a character is 70 wide. What makes
 * the text legible is that ratio, not these numbers on their own: author the same layout at four
 * times the resolution and every glyph gets squeezed into a quarter of the space on screen.
 */
.nameplate {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

.nameplate__name {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(12, 11, 16);
    margin-bottom: 4px;
    flex-shrink: 1;
}

/*
 * flex-shrink: 0 is the load-bearing line. The name and the bar together can ask for more height
 * than the plate has, and flexbox resolves that by shrinking whatever it is allowed to -- which
 * squeezed the bar to four pixels and its fill to zero, leaving a black sliver that looked like a
 * bar that never moved. The name may compress; the bar may not, because the bar is the readout.
 */
.nameplate__track {
    width: 100%;
    height: 16px;
    flex-shrink: 0;
    background-color: rgba(12, 11, 16, 0.75);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(12, 11, 16);
    overflow: hidden;
}

.nameplate__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-ok);
}

.nameplate__fill--low {
    background-color: var(--hud-bad);
}

/* ── option B: life bars along the bottom ───────────────────────────────── */

.lifebars-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    padding: 10px;
}

.lifebars-row {
    flex-direction: row;
    justify-content: center;
}

.lifebar {
    flex-direction: row;
    align-items: center;
    margin: 0 6px;
    padding: 6px 10px;
    background-color: rgba(12, 11, 16, 0.72);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--panel-edge);
}

/* Cropped to the head: the pack's frames are full-body, and a full body shrunk to 40px is a smudge. */
.lifebar__portrait {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    background-color: var(--panel);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.lifebar__column {
    min-width: 130px;
}

.lifebar__name {
    font-size: 12px;
    color: var(--hud-ink);
    margin-bottom: 3px;
}

.lifebar__name--you {
    color: var(--hud-accent);
}

/* The track is the pack's empty bar, sliced so it can be any width; the fill is a flat colour
   inside it rather than the pack's own fill sprite. A sprite fill would have to be masked to a
   fraction of its own width, and a coloured box already reads correctly and can go red on its own
   when the life is low — which is the one thing this bar has to say. */
.lifebar__track {
    height: 14px;
    background-image: none;
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(12, 11, 16, 0.85);
    overflow: hidden;
}

.lifebar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-ok);
}

.lifebar__fill--low {
    background-color: var(--hud-bad);
}

.lifebar__seconds {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--hud-ink);
    margin-left: 10px;
    min-width: 46px;
    -unity-text-align: middle-right;
}

/* Out, not gone: the entry stays so nobody else shifts position. */
.lifebar--out {
    opacity: 0.45;
}

/* Who the spectator camera is following. Arena01 is barely larger than the view, so the camera
   moving is not by itself an answer to "did that do anything?" — this is. */
.lifebar--watched {
    border-color: var(--hud-accent);
    background-color: rgba(238, 108, 92, 0.18);
}

