/*
 * Shared styling for every screen: menu, lobby, loading, in-match HUD and end screen.
 *
 * Deliberately built from a handful of variables rather than per-element values: the palette and
 * spacing are the two things that change when placeholder art is replaced with real art, and having
 * them in one block is the difference between editing five lines and hunting through the file.
 */

:root {
    --bg: rgb(24, 22, 32);
    --panel: rgb(38, 35, 50);
    --panel-edge: rgb(62, 57, 82);
    --ink: rgb(232, 230, 240);
    --ink-dim: rgb(150, 146, 168);
    --accent: rgb(238, 108, 92);
    --accent-ink: rgb(28, 24, 30);
    --ok: rgb(126, 200, 130);
    --bad: rgb(232, 112, 112);

    --gap: 12px;
    --radius: 6px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--bg);
}

.panel {
    width: 420px;
    padding: 24px;
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--panel-edge);
    border-radius: var(--radius);
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    white-space: normal;
}

/* ── fields ─────────────────────────────────────────────────────────────────────── */

.field {
    margin-bottom: var(--gap);
}

.field > .unity-base-field__label {
    min-width: 78px;
    color: var(--ink-dim);
    font-size: 13px;
}

.field > .unity-base-text-field__input {
    background-color: var(--bg);
    border-color: var(--panel-edge);
    border-width: 1px;
    border-radius: 4px;
    color: var(--ink);
    padding: 6px 8px;
}

/* ── buttons ────────────────────────────────────────────────────────────────────── */

.button {
    height: 38px;
    margin: 4px 0 0 0;
    padding: 0 16px;
    background-color: var(--panel-edge);
    border-width: 0;
    border-radius: 4px;
    color: var(--ink);
    font-size: 15px;
    -unity-font-style: bold;
}

.button:hover {
    background-color: rgb(78, 72, 102);
}

.button:disabled {
    opacity: 0.4;
}

.button--primary {
    background-color: var(--accent);
    color: var(--accent-ink);
}

.button--primary:hover {
    background-color: rgb(248, 128, 112);
}

/* ── status line ────────────────────────────────────────────────────────────────── */

.status {
    min-height: 20px;
    margin-top: var(--gap);
    font-size: 13px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

.status--error {
    color: var(--bad);
}

/* ── roster ─────────────────────────────────────────────────────────────────────── */

.roster {
    margin: 4px 0 var(--gap) 0;
    min-height: 140px;
}

.roster-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    margin-bottom: 4px;
    background-color: var(--bg);
    border-radius: 4px;
}

.roster-row__name {
    font-size: 15px;
    color: var(--ink);
}

.roster-row__you {
    color: var(--accent);
}

.roster-row__state {
    font-size: 12px;
    color: var(--ink-dim);
}

.roster-row__state--ready {
    color: var(--ok);
}

.join-code-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gap);
}

.join-code {
    flex-grow: 1;
    padding: 10px;
    background-color: var(--bg);
    border-radius: 4px;
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* Sits next to the code rather than below it, so the pair reads as one control. */
.button--compact {
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 13px;
}

.hidden {
    display: none;
}

/* ── loading screen ─────────────────────────────────────────────────────────────── */

.loading-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 11, 16);
}

.loading-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 6px;
}

.loading-detail {
    font-size: 13px;
    color: var(--ink-dim);
    margin-bottom: 18px;
}

.progress-track {
    width: 380px;
    height: 10px;
    background-color: var(--panel);
    border-radius: 5px;
    overflow: hidden;
}

/* Width is set from code as a percentage; the transition is what keeps it from snapping
   between the coarse steps a per-player count produces. */
.progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--accent);
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.25s;
}

.countdown {
    margin-top: 20px;
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--accent);
}

/* ── end screen ──────────────────────────────────────────────────────── */

/* Translucent, and it does not fill the screen: the arena behind it is still being watched. */
.end-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 11, 16, 0.72);
}

.end-panel {
    min-width: 380px;
    align-items: center;
}

.end-panel .title {
    -unity-text-align: middle-center;
}

.end-panel .subtitle {
    -unity-text-align: middle-center;
}

/* ── in-match scoreboard ────────────────────────────────────────────── */

/* Top-left and out of the way: the match is the thing being watched, not this. */
.scoreboard-root {
    position: absolute;
    top: 12px;
    left: 12px;
    align-items: flex-start;
}

.round-clock {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 6px;
    padding: 2px 8px;
    background-color: rgba(12, 11, 16, 0.55);
    border-radius: 4px;
}

/* Turns amber under half a minute, so running out is felt before it is read. */
.round-clock--urgent {
    color: var(--bad);
}

.scoreboard {
    min-width: 190px;
}

.score-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 8px;
    margin-bottom: 2px;
    background-color: rgba(12, 11, 16, 0.55);
    border-radius: 4px;
}

.score-row__name {
    font-size: 13px;
    color: var(--ink);
    margin-right: 12px;
}

.score-row__you {
    color: var(--accent);
}

.score-row__life {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
}

.score-row__life--low {
    color: var(--bad);
}

/* A player who is out stays on the board, dimmed. Removing the row would shuffle everyone
   else's position at the exact moment the reader is looking for what changed. */
.score-row--out {
    opacity: 0.45;
}

.score-row--out .score-row__life {
    color: var(--ink-dim);
}

